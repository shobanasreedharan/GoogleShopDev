# .env.dev
# SmartCart AI — dev environment variables
# Copy values from: Firebase Console → smartcart-ai-dev → Project Settings → Your apps → Web app
# DO NOT commit this file. Add .env.dev to .gitignore.

# ── Firebase web config ──────────────────────────────────────────
# These are safe to expose client-side (they identify your project, not grant admin access).
# Still keep them out of source control — different values per environment.
REACT_APP_FIREBASE_API_KEY=AIzaSyC9iGceuiwYhFkjhxDJEDZU_8wU0FlnSHM
REACT_APP_FIREBASE_AUTH_DOMAIN=smartcart-ai-dev.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=smartcart-ai-dev
REACT_APP_FIREBASE_STORAGE_BUCKET=smartcart-ai-dev.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=588074098189
REACT_APP_FIREBASE_APP_ID=1:588074098189:web:f16275ef280730d6807f44

# ── Backend URLs ─────────────────────────────────────────────────
# FastAPI on Cloud Run (dev)
REACT_APP_API_URL=https://<your-cloud-run-service>-<hash>-uc.a.run.app/generate
# ADK Agent on Cloud Run (dev)
REACT_APP_AGENT_URL=https://<your-agent-service>-<hash>-uc.a.run.app/chat

# ── Local dev overrides (uncomment to point at local FastAPI) ────
